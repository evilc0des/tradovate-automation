{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "connection-state-message.schema.json",
  "title": "ConnectionStateMessage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageType",
    "version",
    "timestamp",
    "sourceId",
    "correlationId",
    "provider",
    "state"
  ],
  "properties": {
    "messageType": { "const": "ConnectionStateMessage" },
    "version": { "const": "v1" },
    "timestamp": { "type": "string", "format": "date-time" },
    "sourceId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "state": {
      "type": "string",
      "enum": ["Connected", "Disconnected", "Reconnecting", "Unknown"]
    },
    "details": { "type": "string" }
  }
}
