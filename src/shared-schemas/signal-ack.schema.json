{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signal-ack.schema.json",
  "title": "SignalAck",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageType",
    "version",
    "timestamp",
    "sourceId",
    "correlationId",
    "signalId",
    "status"
  ],
  "properties": {
    "messageType": { "const": "SignalAck" },
    "version": { "const": "v1" },
    "timestamp": { "type": "string", "format": "date-time" },
    "sourceId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "signalId": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["Accepted", "Rejected", "Disarmed"]
    },
    "detail": { "type": "string" }
  }
}
